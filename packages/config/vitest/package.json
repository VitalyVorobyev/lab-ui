{
  "name": "@vitavision/config-vitest",
  "version": "0.1.0",
  "description": "Shared Vitest presets for vitavision frontends.",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VitalyVorobyev/lab-ui.git",
    "directory": "packages/config/vitest"
  },
  "type": "module",
  "sideEffects": [
    "./setup.js"
  ],
  "files": [
    "index.js",
    "index.d.ts",
    "setup.js",
    "stories.js",
    "stories.d.ts"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./stories": {
      "types": "./stories.d.ts",
      "default": "./stories.js"
    },
    "./setup": "./setup.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "@vitest/coverage-v8": "^5.0.2",
    "@vitest/browser-playwright": "^5.0.2",
    "@storybook/react-vite": "^10.6.0"
  },
  "peerDependenciesMeta": {
    "@vitest/coverage-v8": {
      "optional": true
    },
    "@storybook/react-vite": {
      "optional": true
    }
  }
}
