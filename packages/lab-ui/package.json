{
  "name": "@vitavision/lab-ui",
  "version": "0.5.0",
  "description": "DEPRECATED \u2014 use @vitavision/ui, /forms, /charts and /stage2d. Re-exports them for 0.x consumers.",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VitalyVorobyev/lab-ui.git",
    "directory": "packages/lab-ui"
  },
  "homepage": "https://github.com/VitalyVorobyev/lab-ui/tree/main/packages/lab-ui#readme",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "exports": {
    ".": {
      "@vitavision/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "api": "api-extractor run --local",
    "api:check": "api-extractor run"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "dependencies": {
    "@vitavision/ui": "workspace:^",
    "@vitavision/forms": "workspace:^",
    "@vitavision/charts": "workspace:^",
    "@vitavision/stage2d": "workspace:^"
  }
}
