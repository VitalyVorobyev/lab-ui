{
  "name": "@vitavision/ui",
  "version": "0.5.0",
  "description": "The vitavision instrument design system: Tailwind v4 tokens, theme, and React primitives.",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VitalyVorobyev/lab-ui.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/VitalyVorobyev/lab-ui/tree/main/packages/ui#readme",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*",
    "!src/**/*.stories.*",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "exports": {
    ".": {
      "@vitavision/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "api": "api-extractor run --local",
    "coverage": "vitest run --coverage",
    "api:check": "api-extractor run"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.6.0",
    "storybook": "10.6.0"
  }
}
