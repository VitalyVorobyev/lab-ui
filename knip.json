{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "compilers": {
    "css": true
  },
  "workspaces": {
    ".": {
      "entry": [
        "tools/inventory/*.ts",
        "tools/dod/*.ts",
        "tools/visual-language/*.ts"
      ],
      "project": [
        "tools/inventory/**/*.ts",
        "tools/dod/**/*.ts",
        "tools/visual-language/**/*.ts"
      ],
      "ignoreDependencies": [
        "@arethetypeswrong/cli",
        "@fontsource-variable/ibm-plex-sans",
        "@ibm/plex-mono"
      ]
    },
    "packages/*": {
      "entry": [
        "src/**/*.stories.tsx"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    },
    "packages/three": {
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/lab-ui": {
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    },
    "packages/config/eslint": {
      "entry": [
        "rules/*.js"
      ]
    },
    "packages/config/ts": {
      "ignoreDependencies": [
        "tsdown"
      ]
    },
    "packages/config/vitest": {
      "ignoreDependencies": [
        "@storybook/react-vite"
      ]
    },
    "apps/storybook": {
      "entry": [
        ".storybook/*.{ts,tsx}",
        "src/**/*.stories.tsx",
        "test/**/*.{ts,tsx}",
        "visual/**/*.ts"
      ],
      "project": [
        "**/*.{ts,tsx,css}"
      ]
    },
    "tools/bench/*": {
      "project": [
        "**/*.{ts,tsx,css}"
      ]
    }
  },
  "ignoreIssues": {
    "packages/ui/src/components/ui/Input.tsx": [
      "duplicates"
    ]
  },
  "ignoreExportsUsedInFile": true
}
